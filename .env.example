# ============================================================
# Soma & Souffle — configuration (copier vers .env et adapter)
# ============================================================

# Port public exposé sur la machine hôte
APP_PORT=8080

# ---- LLM : 3 scénarios ----

# 1) DEV / machine perso avec Ollama installé sur l'hôte (défaut)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# 2) VPS 4 Go+ avec Ollama conteneurisé (docker compose --profile ollama up -d)
#    puis : docker compose exec ollama ollama pull qwen2.5:3b
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:3b

# 3) VPS 1 Go (pas d'Ollama possible) — API cloud compatible OpenAI.
#    Exemples de base_url :
#      OpenAI    : https://api.openai.com/v1
#      Groq      : https://api.groq.com/openai/v1
#      Mistral   : https://api.mistral.ai/v1
#      OpenRouter: https://openrouter.ai/api/v1
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxx
# Palier gratuit Groq : limite de sortie à 1000 tokens/min (OTPM) — ne pas dépasser.
# LLM_MAX_TOKENS=600

# ---- RAG ----
# Nombre de passages de la base de connaissance injectés dans le prompt
RAG_TOP_K=3
